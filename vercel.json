{
  "functions": {
    "api/send_notification.ts": {
      "memory": 512,
      "maxDuration": 15
    },
    "api/process_payment.ts": {
      "memory": 512,
      "maxDuration": 15
    },
    "api/check_payment.ts": {
      "memory": 512,
      "maxDuration": 15
